<Window x:Class="Edon.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Edon — Creative workspace" Width="1440" Height="920" MinWidth="1000" MinHeight="650" WindowStartupLocation="CenterScreen" Background="#171918" Foreground="#EEEFE9">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
  <Border Background="#202221" Padding="18,0"><DockPanel>
   <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center"><Viewbox Width="28" Height="28" Margin="0,0,10,0"><Canvas Width="32" Height="32"><Path Fill="#EEEFE9" Data="M29 4H15a12 12 0 0 0 0 24h14v-6H15a6 6 0 0 1 0-12h14ZM14 13h11v6H14a3 3 0 0 1 0-6Z"/></Canvas></Viewbox><TextBlock Text="edon" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="NATIVE PREVIEW" Foreground="#929C89" FontSize="10" Margin="24,10,14,0"/></StackPanel>
   <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center"><Button Content="Open" Click="OpenClick"/><Button Content="Save" Click="SaveClick"/><Button Content="Export" Click="ExportClick" Background="#3C4439"/></StackPanel>
   <TextBox x:Name="ProjectName" Width="220" HorizontalAlignment="Center" VerticalAlignment="Center" TextChanged="NameChanged" ToolTip="Project name"/>
  </DockPanel></Border>
  <DockPanel Grid.Row="1" Margin="18,2"><TextBlock x:Name="KindLabel" Width="160" VerticalAlignment="Center" Foreground="#ABB49E"/><StackPanel Orientation="Horizontal"><Button Content="↶" ToolTip="Undo · Ctrl+Z" Click="UndoClick"/><Button Content="↷" ToolTip="Redo · Ctrl+Shift+Z" Click="RedoClick"/><Button x:Name="FontButton" Content="Segoe UI ▾" Click="FontClick"/><Button x:Name="SizeButton" Content="36 px ▾" Click="SizeClick"/><Button Content="B" FontWeight="Bold" Click="BoldClick"/><Button Content="I" FontStyle="Italic" Click="ItalicClick"/><Button Content="Print / PDF" Click="PrintClick"/><Button Content="Present" Click="PresentClick"/></StackPanel></DockPanel>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
   <Border Background="#202221" Padding="12"><DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Top"><TextBlock Text="WORKSPACE" FontSize="10" Foreground="#939C8F" Margin="10,12"/><WrapPanel><Button Content="＋ Canvas" Tag="Canvas" Click="NewClick"/><Button Content="＋ Doc" Tag="Document" Click="NewClick"/><Button Content="＋ Slides" Tag="Presentation" Click="NewClick"/></WrapPanel><Button Content="Recent projects ▾" Click="RecentClick"/><TextBlock Text="TOOLS" FontSize="10" Foreground="#939C8F" Margin="10,24,10,10"/><UniformGrid Columns="2"><Button Content="↖ Select" Tag="Select" Click="ToolClick"/><Button Content="□ Shape" Tag="Rectangle" Click="ToolClick"/><Button Content="○ Ellipse" Tag="Ellipse" Click="ToolClick"/><Button Content="T Text" Tag="Text" Click="ToolClick"/><Button Content="⌁ Brush" Tag="Brush" Click="ToolClick"/><Button Content="▧ Image" Click="ImageClick"/></UniformGrid><TextBlock Text="PAGES" FontSize="10" Foreground="#939C8F" Margin="10,24,10,10"/><WrapPanel><Button Content="＋" ToolTip="Add page" Click="AddPageClick"/><Button Content="Duplicate" Click="DuplicatePageClick"/><Button Content="−" ToolTip="Delete page" Click="DeletePageClick"/></WrapPanel></StackPanel>
    <ListBox x:Name="PagesList" SelectionChanged="PageChanged"/>
   </DockPanel></Border>
   <Grid Grid.Column="1" ClipToBounds="True">
    <ScrollViewer x:Name="CanvasScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Canvas x:Name="Artboard" Width="1280" Height="720" Background="#F4F3EE" Margin="50" MouseLeftButtonDown="CanvasDown" MouseMove="CanvasMove" MouseLeftButtonUp="CanvasUp" LostMouseCapture="CanvasLostCapture"/></ScrollViewer>
    <RichTextBox x:Name="DocumentEditor" Visibility="Collapsed" Margin="36" Padding="54" Background="#F4F3EE" Foreground="#20211F" BorderThickness="0" FontSize="16" VerticalScrollBarVisibility="Auto" AcceptsTab="True" TextChanged="DocumentChanged"/>
   </Grid>
   <Border Grid.Column="2" Background="#202221" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="INSPECTOR" FontSize="10" Foreground="#939C8F" Margin="0,14"/>
    <TextBlock x:Name="SelectionLabel" Text="Select a layer" FontSize="18" Margin="0,4,0,16"/>
    <TextBlock Text="Fill / text color" Foreground="#ADB3A8" FontSize="11"/><WrapPanel x:Name="Swatches"/>
    <TextBox x:Name="ColorInput" Text="#899978" LostFocus="ColorChanged" ToolTip="Hex color, e.g. #899978"/>
    <TextBlock Text="Opacity" Foreground="#ADB3A8" FontSize="11" Margin="0,12,0,0"/><Slider x:Name="OpacityInput" Minimum="0" Maximum="1" Value="1" ValueChanged="OpacityChanged" PreviewMouseLeftButtonDown="PropertyBegin"/>
    <UniformGrid Columns="2"><StackPanel Margin="0,0,8,0"><TextBlock Text="Width" FontSize="11"/><TextBox x:Name="WidthInput" LostFocus="GeometryChanged"/></StackPanel><StackPanel><TextBlock Text="Height" FontSize="11"/><TextBox x:Name="HeightInput" LostFocus="GeometryChanged"/></StackPanel></UniformGrid>
    <TextBlock Text="Text" FontSize="11" Margin="0,12,0,0"/><TextBox x:Name="LayerTextInput" AcceptsReturn="True" MinHeight="60" TextWrapping="Wrap" LostFocus="TextChanged"/>
    <TextBlock Text="Brush size" FontSize="11" Margin="0,12,0,0"/><Slider x:Name="BrushSize" Minimum="1" Maximum="80" Value="8"/>
    <WrapPanel><Button Content="Duplicate" Click="DuplicateClick"/><Button Content="Delete" Click="DeleteClick"/><Button Content="↑ Raise" Click="RaiseClick"/><Button Content="↓ Lower" Click="LowerClick"/></WrapPanel>
    <TextBlock Text="LAYERS" FontSize="10" Foreground="#939C8F" Margin="0,24,0,12"/><ListBox x:Name="LayersList" SelectionChanged="LayerChanged"/>
    <TextBlock Text="Drag images onto the canvas. Every brush stroke is its own layer." TextWrapping="Wrap" Foreground="#858E80" FontSize="11" Margin="0,24,0,0"/>
   </StackPanel></ScrollViewer></Border>
  </Grid>
  <DockPanel Grid.Row="3" Margin="18,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Fit" Padding="8,2" Click="FitClick"/><Slider x:Name="Zoom" Width="100" Minimum="10" Maximum="150" Value="60" ValueChanged="ZoomChanged" ToolTip="Canvas zoom"/><TextBlock x:Name="ZoomLabel" Text="60%" FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel><TextBlock x:Name="Status" Text="Ready" FontSize="11" Foreground="#939C8F" VerticalAlignment="Center"/></DockPanel>
 </Grid>
</Window>

