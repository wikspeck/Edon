{
  "openapi": "3.1.0",
  "info": {
    "title": "Edon Public API",
    "version": "1.0.0-draft",
    "description": "Stable contract implemented by the Edon application service. Network exposure remains disabled until a server-side persistence and OAuth adapter is configured."
  },
  "servers": [{ "url": "https://api.example.invalid/api/v1", "description": "Placeholder; do not deploy without the documented server adapter" }],
  "security": [{ "oauth2": [] }],
  "tags": [
    { "name": "Read", "description": "Operations that do not modify Edon data." },
    { "name": "Write", "description": "Operations that modify Edon data." },
    { "name": "Destructive", "description": "Operations that delete data or can contain deletions and should receive explicit user confirmation." }
  ],
  "paths": {
    "/capabilities": {
      "get": { "operationId": "getCapabilities", "summary": "Discover implemented API capabilities and limits", "tags": ["Read"], "security": [], "responses": { "200": { "description": "Capabilities", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Capabilities" } } } } } }
    },
    "/projects": {
      "get": { "operationId": "listProjects", "summary": "List accessible project containers without document contents", "tags": ["Read"], "security": [{ "oauth2": ["projects:read"] }], "parameters": [{ "$ref": "#/components/parameters/Cursor" }, { "$ref": "#/components/parameters/Limit" }], "responses": { "200": { "$ref": "#/components/responses/ProjectPage" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "429": { "$ref": "#/components/responses/RateLimited" } } },
      "post": { "operationId": "createProject", "summary": "Create one project container", "tags": ["Write"], "security": [{ "oauth2": ["projects:write"] }], "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateProject" }, "example": { "name": "Biology presentation", "description": "Chapter 4 review" } } } }, "responses": { "201": { "description": "Created project", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProjectMutation" } } } }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" } } }
    },
    "/projects/{projectId}": {
      "parameters": [{ "$ref": "#/components/parameters/ProjectId" }],
      "get": { "operationId": "getProject", "summary": "Get project metadata by stable ID", "tags": ["Read"], "security": [{ "oauth2": ["projects:read"] }], "responses": { "200": { "description": "Project", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Project" } } } }, "404": { "$ref": "#/components/responses/Error" } } },
      "patch": { "operationId": "updateProject", "summary": "Rename or describe a project using optimistic concurrency", "tags": ["Write"], "security": [{ "oauth2": ["projects:write"] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateProject" } } } }, "responses": { "200": { "description": "Updated project", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProjectMutation" } } } }, "409": { "$ref": "#/components/responses/Error" } } },
      "delete": { "operationId": "deleteProject", "summary": "Delete a project container but not its documents", "description": "Destructive. The caller should obtain explicit confirmation first.", "tags": ["Destructive"], "security": [{ "oauth2": ["projects:write"] }], "parameters": [{ "$ref": "#/components/parameters/IfMatchRevision" }], "responses": { "204": { "description": "Deleted" }, "409": { "$ref": "#/components/responses/Error" } } }
    },
    "/documents": {
      "get": { "operationId": "listDocuments", "summary": "List accessible design documents without slides or elements", "tags": ["Read"], "security": [{ "oauth2": ["documents:read"] }], "parameters": [{ "$ref": "#/components/parameters/ProjectIdQuery" }, { "$ref": "#/components/parameters/Cursor" }, { "$ref": "#/components/parameters/Limit" }], "responses": { "200": { "$ref": "#/components/responses/DocumentPage" } } },
      "post": { "operationId": "createDocument", "summary": "Create one design document with an initial slide", "tags": ["Write"], "security": [{ "oauth2": ["documents:write"] }], "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateDocument" }, "example": { "name": "Cell biology", "width": 1920, "height": 1080, "projectId": "project_12345678" } } } }, "responses": { "201": { "description": "Created document", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DocumentMutation" } } } }, "400": { "$ref": "#/components/responses/Error" } } }
    },
    "/documents/{documentId}": {
      "parameters": [{ "$ref": "#/components/parameters/DocumentId" }],
      "get": { "operationId": "getDocument", "summary": "Get one design document and current revision", "tags": ["Read"], "security": [{ "oauth2": ["documents:read"] }], "responses": { "200": { "description": "Document", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Document" } } } }, "404": { "$ref": "#/components/responses/Error" } } },
      "patch": { "operationId": "updateDocument", "summary": "Update document metadata", "tags": ["Write"], "security": [{ "oauth2": ["documents:write"] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateDocument" } } } }, "responses": { "200": { "description": "Updated document", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DocumentMutation" } } } }, "409": { "$ref": "#/components/responses/Error" } } }
    },
    "/documents/{documentId}/slides": {
      "parameters": [{ "$ref": "#/components/parameters/DocumentId" }],
      "get": { "operationId": "listSlides", "summary": "List slides in document order", "tags": ["Read"], "security": [{ "oauth2": ["documents:read"] }], "parameters": [{ "$ref": "#/components/parameters/Cursor" }, { "$ref": "#/components/parameters/Limit" }], "responses": { "200": { "description": "Slides", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SlidePage" } } } } } },
      "post": { "operationId": "createSlide", "summary": "Append one slide", "tags": ["Write"], "security": [{ "oauth2": ["documents:write"] }], "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateSlide" }, "example": { "name": "Summary", "ifMatchRevision": 1 } } } }, "responses": { "201": { "description": "Created slide", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SlideMutation" } } } }, "409": { "$ref": "#/components/responses/Error" } } }
    },
    "/documents/{documentId}/slides/{slideId}": {
      "parameters": [{ "$ref": "#/components/parameters/DocumentId" }, { "$ref": "#/components/parameters/SlideId" }],
      "patch": { "operationId": "updateSlide", "summary": "Update slide metadata or canvas properties", "tags": ["Write"], "security": [{ "oauth2": ["documents:write"] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateSlide" } } } }, "responses": { "200": { "description": "Updated slide", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SlideMutation" } } } }, "409": { "$ref": "#/components/responses/Error" } } }
    },
    "/documents/{documentId}/slides/{slideId}/elements": {
      "parameters": [{ "$ref": "#/components/parameters/DocumentId" }, { "$ref": "#/components/parameters/SlideId" }],
      "get": { "operationId": "listElements", "summary": "List deterministically addressable elements", "tags": ["Read"], "security": [{ "oauth2": ["documents:read"] }], "parameters": [{ "$ref": "#/components/parameters/Cursor" }, { "$ref": "#/components/parameters/Limit" }], "responses": { "200": { "description": "Elements", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ElementPage" } } } } } },
      "post": { "operationId": "createElement", "summary": "Create one element and return a compact mutation result", "tags": ["Write"], "security": [{ "oauth2": ["documents:write"] }], "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateElement" }, "example": { "type": "text", "x": 120, "y": 90, "width": 640, "height": 90, "text": "Mitosis", "fontSize": 56, "ifMatchRevision": 2 } } } }, "responses": { "201": { "description": "Created element", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ElementMutation" } } } }, "400": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } }
    },
    "/documents/{documentId}/slides/{slideId}/elements/{elementId}": {
      "parameters": [{ "$ref": "#/components/parameters/DocumentId" }, { "$ref": "#/components/parameters/SlideId" }, { "$ref": "#/components/parameters/ElementId" }],
      "patch": { "operationId": "updateElement", "summary": "Update selected element fields by stable ID", "tags": ["Write"], "security": [{ "oauth2": ["documents:write"] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateElement" }, "examples": { "text": { "value": { "patch": { "text": "Updated heading" }, "ifMatchRevision": 3 } }, "move": { "value": { "patch": { "x": 160, "y": 120 }, "ifMatchRevision": 3 } } } } } }, "responses": { "200": { "description": "Updated element", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ElementMutation" } } } }, "409": { "$ref": "#/components/responses/Error" } } },
      "delete": { "operationId": "deleteElement", "summary": "Delete an element and its direct hierarchy", "description": "Destructive. Obtain confirmation when deletion is not an obvious part of the user's request.", "tags": ["Destructive"], "security": [{ "oauth2": ["documents:write"] }], "parameters": [{ "$ref": "#/components/parameters/IfMatchRevision" }], "responses": { "204": { "description": "Deleted" }, "409": { "$ref": "#/components/responses/Error" } } }
    },
    "/documents/{documentId}/operations": {
      "post": { "operationId": "applyOperations", "summary": "Validate or atomically apply up to 50 changes", "description": "Use dryRun for complex changes. A failure commits none of the operations.", "tags": ["Write", "Destructive"], "security": [{ "oauth2": ["documents:write"] }], "parameters": [{ "$ref": "#/components/parameters/DocumentId" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApplyOperations" }, "example": { "ifMatchRevision": 4, "operations": [{ "op": "update_element", "slideId": "page_12345678", "elementId": "text_12345678", "patch": { "x": 180 } }], "dryRun": false } } } }, "responses": { "200": { "description": "Compact change summary", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ChangeSummary" } } } }, "400": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" }, "413": { "$ref": "#/components/responses/Error" } } }
    },
    "/search": {
      "get": { "operationId": "search", "summary": "Search accessible project, document, slide, and element metadata", "tags": ["Read"], "security": [{ "oauth2": ["projects:read", "documents:read"] }], "parameters": [{ "name": "q", "in": "query", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 200 } }, { "$ref": "#/components/parameters/Cursor" }, { "$ref": "#/components/parameters/Limit" }], "responses": { "200": { "description": "Search results", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SearchPage" } } } }, "400": { "$ref": "#/components/responses/Error" } } }
    }
  },
  "components": {
    "securitySchemes": { "oauth2": { "type": "oauth2", "description": "OAuth 2.1 authorization code with PKCE. Provider and endpoints are selected by the future server adapter.", "flows": { "authorizationCode": { "authorizationUrl": "https://auth.example.invalid/authorize", "tokenUrl": "https://auth.example.invalid/token", "scopes": { "projects:read": "Read project metadata", "projects:write": "Create and modify projects", "documents:read": "Read documents, slides, and elements", "documents:write": "Create and modify documents, slides, and elements", "assets:read": "Read asset metadata", "assets:write": "Upload and delete assets", "exports:create": "Create exports" } } } } },
    "parameters": {
      "Cursor": { "name": "cursor", "in": "query", "schema": { "type": "string", "pattern": "^c_[0-9]+$" } },
      "Limit": { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 } },
      "IdempotencyKey": { "name": "Idempotency-Key", "in": "header", "schema": { "type": "string", "minLength": 8, "maxLength": 128 } },
      "IfMatchRevision": { "name": "If-Match-Revision", "in": "header", "required": true, "schema": { "type": "integer", "minimum": 1 } },
      "ProjectId": { "name": "projectId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Id" } },
      "ProjectIdQuery": { "name": "projectId", "in": "query", "schema": { "$ref": "#/components/schemas/Id" } },
      "DocumentId": { "name": "documentId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Id" } },
      "SlideId": { "name": "slideId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Id" } },
      "ElementId": { "name": "elementId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Id" } }
    },
    "responses": {
      "Error": { "description": "Structured error. The X-Request-ID response header matches error.requestId.", "headers": { "X-Request-ID": { "schema": { "type": "string" } } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "RateLimited": { "description": "Rate limit exceeded", "headers": { "Retry-After": { "schema": { "type": "integer", "minimum": 1 } }, "X-RateLimit-Limit": { "schema": { "type": "integer" } }, "X-RateLimit-Remaining": { "schema": { "type": "integer" } } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "ProjectPage": { "description": "Project page", "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/CursorPage" }, { "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/Project" } } } }] } } } },
      "DocumentPage": { "description": "Document page", "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/CursorPage" }, { "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/DocumentSummary" } } } }] } } } }
    },
    "schemas": {
      "Id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}_[a-zA-Z0-9-]{8,80}$" },
      "CursorPage": { "type": "object", "required": ["items", "nextCursor"], "properties": { "items": { "type": "array" }, "nextCursor": { "type": ["string", "null"] } } },
      "Project": { "type": "object", "additionalProperties": false, "required": ["version", "revision", "id", "name", "createdAt", "updatedAt", "documentIds", "metadata"], "properties": { "version": { "const": 1 }, "revision": { "type": "integer", "minimum": 1 }, "id": { "$ref": "#/components/schemas/Id" }, "name": { "type": "string", "maxLength": 80 }, "createdAt": { "type": "string", "format": "date-time" }, "updatedAt": { "type": "string", "format": "date-time" }, "documentIds": { "type": "array", "items": { "$ref": "#/components/schemas/Id" } }, "metadata": { "type": "object", "properties": { "description": { "type": "string", "maxLength": 500 }, "thumbnailDocumentId": { "$ref": "#/components/schemas/Id" }, "sort": { "enum": ["updated", "name"] } } } } },
      "DocumentSummary": { "type": "object", "required": ["id", "name", "revision", "createdAt", "updatedAt"], "properties": { "id": { "$ref": "#/components/schemas/Id" }, "name": { "type": "string" }, "revision": { "type": "integer" }, "createdAt": { "type": "string", "format": "date-time" }, "updatedAt": { "type": "string", "format": "date-time" } } },
      "Document": { "allOf": [{ "$ref": "#/components/schemas/DocumentSummary" }, { "type": "object", "required": ["version", "activePageId", "pages", "palette"], "properties": { "version": { "const": 4 }, "activePageId": { "$ref": "#/components/schemas/Id" }, "pages": { "type": "array", "items": { "$ref": "#/components/schemas/Slide" } }, "palette": { "type": "array", "items": { "type": "object" } } } }] },
      "Slide": { "type": "object", "required": ["id", "name", "width", "height", "background", "elements"], "properties": { "id": { "$ref": "#/components/schemas/Id" }, "name": { "type": "string", "maxLength": 120 }, "width": { "type": "number", "minimum": 16, "maximum": 8192 }, "height": { "type": "number", "minimum": 16, "maximum": 8192 }, "background": { "$ref": "#/components/schemas/Color" }, "elements": { "type": "array", "items": { "$ref": "#/components/schemas/Element" } } } },
      "Element": { "type": "object", "required": ["id", "type", "name", "parentId", "x", "y", "width", "height", "rotation", "opacity", "visible", "locked"], "properties": { "id": { "$ref": "#/components/schemas/Id" }, "type": { "enum": ["group", "frame", "rectangle", "ellipse", "line", "arrow", "polygon", "star", "path", "text", "image", "raster"] }, "name": { "type": "string" }, "parentId": { "oneOf": [{ "$ref": "#/components/schemas/Id" }, { "type": "null" }] }, "x": { "type": "number" }, "y": { "type": "number" }, "width": { "type": "number" }, "height": { "type": "number" }, "rotation": { "type": "number" }, "opacity": { "type": "number", "minimum": 0, "maximum": 1 }, "visible": { "type": "boolean" }, "locked": { "type": "boolean" }, "text": { "type": "string", "maxLength": 50000 }, "fill": { "$ref": "#/components/schemas/Color" }, "stroke": { "$ref": "#/components/schemas/Color" }, "imageUrl": { "type": "string", "description": "Raster data URL only in v1. Use the future Asset API for remote images." } } },
      "Color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$" },
      "CreateProject": { "type": "object", "additionalProperties": false, "required": ["name"], "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 80 }, "description": { "type": "string", "maxLength": 500 } } },
      "UpdateProject": { "type": "object", "additionalProperties": false, "required": ["ifMatchRevision"], "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 80 }, "description": { "type": "string", "maxLength": 500 }, "ifMatchRevision": { "type": "integer", "minimum": 1 } } },
      "CreateDocument": { "type": "object", "additionalProperties": false, "required": ["name", "width", "height"], "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 120 }, "width": { "type": "number", "minimum": 16, "maximum": 8192 }, "height": { "type": "number", "minimum": 16, "maximum": 8192 }, "projectId": { "$ref": "#/components/schemas/Id" } } },
      "UpdateDocument": { "type": "object", "additionalProperties": false, "required": ["ifMatchRevision"], "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 120 }, "ifMatchRevision": { "type": "integer", "minimum": 1 } } },
      "CreateSlide": { "type": "object", "additionalProperties": false, "required": ["ifMatchRevision"], "properties": { "name": { "type": "string", "maxLength": 120 }, "width": { "type": "number", "minimum": 16, "maximum": 8192 }, "height": { "type": "number", "minimum": 16, "maximum": 8192 }, "background": { "$ref": "#/components/schemas/Color" }, "ifMatchRevision": { "type": "integer", "minimum": 1 } } },
      "UpdateSlide": { "$ref": "#/components/schemas/CreateSlide" },
      "ElementPatch": { "type": "object", "additionalProperties": false, "properties": { "name": { "type": "string", "maxLength": 120 }, "parentId": { "oneOf": [{ "$ref": "#/components/schemas/Id" }, { "type": "null" }] }, "x": { "type": "number" }, "y": { "type": "number" }, "width": { "type": "number", "minimum": 16, "maximum": 8192 }, "height": { "type": "number", "minimum": 16, "maximum": 8192 }, "rotation": { "type": "number" }, "opacity": { "type": "number", "minimum": 0, "maximum": 1 }, "fill": { "$ref": "#/components/schemas/Color" }, "stroke": { "$ref": "#/components/schemas/Color" }, "text": { "type": "string", "maxLength": 50000 }, "fontSize": { "type": "number" }, "visible": { "type": "boolean" }, "locked": { "type": "boolean" }, "imageUrl": { "type": "string", "pattern": "^data:image/(png|jpeg|webp|gif);base64," } } },
      "CreateElement": { "allOf": [{ "$ref": "#/components/schemas/ElementPatch" }, { "type": "object", "required": ["type", "x", "y", "ifMatchRevision"], "properties": { "type": { "enum": ["group", "frame", "rectangle", "ellipse", "line", "arrow", "polygon", "star", "path", "text", "image", "raster"] }, "x": { "type": "number" }, "y": { "type": "number" }, "ifMatchRevision": { "type": "integer", "minimum": 1 } } }] },
      "UpdateElement": { "type": "object", "additionalProperties": false, "required": ["patch", "ifMatchRevision"], "properties": { "patch": { "$ref": "#/components/schemas/ElementPatch" }, "ifMatchRevision": { "type": "integer", "minimum": 1 } } },
      "ApplyOperations": { "type": "object", "additionalProperties": false, "required": ["ifMatchRevision", "operations"], "properties": { "ifMatchRevision": { "type": "integer", "minimum": 1 }, "operations": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "type": "object", "required": ["op"], "properties": { "op": { "enum": ["create_slide", "update_slide", "delete_slide", "create_element", "update_element", "delete_element"] }, "slideId": { "$ref": "#/components/schemas/Id" }, "elementId": { "$ref": "#/components/schemas/Id" }, "slide": { "type": "object" }, "element": { "type": "object" }, "patch": { "type": "object" } } } }, "dryRun": { "type": "boolean", "default": false } } },
      "ChangeSummary": { "type": "object", "required": ["changed", "created", "updated", "deleted", "documentRevision", "requestId"], "properties": { "changed": { "type": "integer" }, "created": { "type": "integer" }, "updated": { "type": "integer" }, "deleted": { "type": "integer" }, "documentRevision": { "type": "integer" }, "requestId": { "type": "string" } } },
      "ProjectMutation": { "type": "object", "required": ["resource", "revision", "requestId"], "properties": { "resource": { "$ref": "#/components/schemas/Project" }, "revision": { "type": "integer" }, "requestId": { "type": "string" } } },
      "DocumentMutation": { "type": "object", "required": ["resource", "revision", "requestId"], "properties": { "resource": { "$ref": "#/components/schemas/Document" }, "revision": { "type": "integer" }, "requestId": { "type": "string" } } },
      "SlideMutation": { "type": "object", "required": ["resource", "revision", "requestId"], "properties": { "resource": { "$ref": "#/components/schemas/Slide" }, "revision": { "type": "integer" }, "requestId": { "type": "string" } } },
      "ElementMutation": { "type": "object", "required": ["resource", "revision", "requestId"], "properties": { "resource": { "$ref": "#/components/schemas/Element" }, "revision": { "type": "integer" }, "requestId": { "type": "string" } } },
      "SlidePage": { "allOf": [{ "$ref": "#/components/schemas/CursorPage" }, { "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/Slide" } } } }] },
      "ElementPage": { "allOf": [{ "$ref": "#/components/schemas/CursorPage" }, { "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/Element" } } } }] },
      "SearchPage": { "allOf": [{ "$ref": "#/components/schemas/CursorPage" }, { "properties": { "items": { "type": "array", "items": { "type": "object", "required": ["resourceType", "resourceId", "title"], "properties": { "resourceType": { "enum": ["project", "document", "slide", "element"] }, "resourceId": { "$ref": "#/components/schemas/Id" }, "projectId": { "$ref": "#/components/schemas/Id" }, "documentId": { "$ref": "#/components/schemas/Id" }, "slideId": { "$ref": "#/components/schemas/Id" }, "title": { "type": "string" }, "snippet": { "type": "string" } } } } } }] },
      "Capabilities": { "type": "object", "required": ["apiVersion", "persistence", "authentication", "features", "exportFormats", "limits"], "properties": { "apiVersion": { "const": "v1" }, "persistence": { "const": "browser-local" }, "authentication": { "const": "host-adapter-required" }, "features": { "type": "object" }, "exportFormats": { "type": "array", "items": { "enum": ["png", "jpeg", "webp", "svg"] } }, "limits": { "type": "object" } } },
