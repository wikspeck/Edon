{
  "name": "edon",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "packageManager": "npm@11.6.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --configLoader native",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test:api": "node scripts/test-public-api.mjs",
    "test:music": "node scripts/test-music.mjs",
    "test:editor": "node scripts/test-editor.mjs",
    "validate:openapi": "node scripts/validate-openapi.mjs",
    "check": "npm run lint && npm run typecheck && npm run test:editor && npm run test:music && npm run test:api && npm run test:mcp && npm run validate:openapi && npm run test:download && npm run build",
    "preview": "vite preview",
    "cf:dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run",
    "desktop:dev": "npm run build && electron .",
    "desktop:build": "npm run build && npm run desktop:runtime && electron-builder --win portable --x64 --publish never",
    "desktop:check": "node --check desktop/electron/main.cjs",
    "desktop:package": "node scripts/desktop/package-download.mjs",
    "test:download": "node scripts/test-download.mjs",
    "desktop:runtime": "node node_modules/electron/install.js",
    "desktop:publish": "node scripts/desktop/validate-release.mjs && wrangler deploy --config wrangler.downloads.jsonc",
    "test:mcp": "node scripts/test-mcp.mjs"
  },
  "dependencies": {
    "lucide-react": "1.47.0",
    "paper": "0.12.18",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "wrangler": "4.135.0"
  },
  "main": "desktop/electron/main.cjs",
  "description": "Edon creative suite",
  "author": "Edon",
  "build": {
    "appId": "dev.edon.desktop",
    "productName": "Edon",
    "directories": {
      "output": "artifacts/electron"
    },
    "files": [
      "dist/**/*",
      "!dist/downloads/**/*",
      "!dist/**/*.map",
      "desktop/electron/main.cjs",
      "package.json",
      "desktop/electron/preload.cjs",
      "desktop/electron/mcp-bridge.cjs"
    ],
    "win": {
      "target": "portable",
      "icon": "desktop/Edon.Desktop/Assets/edon.ico"
    },
    "portable": {
      "artifactName": "Edon-${version}-win-x64.exe"
    },
    "asar": true,
    "electronDist": "node_modules/electron/dist"
  }
}
