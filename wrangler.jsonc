{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "edon",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/download/*", "/downloads/release.json"],
    "not_found_handling": "single-page-application"
  },
  "services": [{"binding":"DOWNLOADS","service":"edon-downloads"}],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
